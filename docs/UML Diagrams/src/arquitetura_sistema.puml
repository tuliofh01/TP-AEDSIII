@startuml arquitetura_sistema
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 13

title Arquitetura do Sistema - TP AEDS III

package "GUI (C++ / HelloImGui)" {
    [main.cpp] as main
    [HelloImGui] as hello
    [ImguiBindings] as bindings
}

package "Lua Views" {
    [router.lua] as router
    [common.lua] as common
    [MainMenu.lua] as menu
    [StudentViews] as stu
    [TeacherViews] as tch
    [SubjectViews] as sub
    [EnrollmentViews] as enr
}

package "project_utility" {
    [Constants.hpp] as const
    [Enums.hpp] as enums
}

package "project_model" {
    [Record.hpp] as model
    [BPlusTree.hpp] as btree
}

package "project_controller" {
    [DataManager] as dm
    [FileManager] as fm
    [IndexCtrl] as idx
}

database "records.dat\n(Header + Chunks)" as dat
database "records.idx\n(Hash Index)" as idxfile

main --> hello
main --> bindings
main --> dm
hello --> router
bindings --> router
dm --> bindings

router --> menu
router --> stu
router --> tch
router --> sub
router --> enr
router --> common

menu --> dm
stu --> dm
tch --> dm
sub --> dm
enr --> dm

dm --> fm
dm --> idx
dm --> btree

fm --> model
model --> const
model --> enums
idx --> const
btree --> model

fm --> dat
idx --> idxfile
btree --> dat

@enduml
