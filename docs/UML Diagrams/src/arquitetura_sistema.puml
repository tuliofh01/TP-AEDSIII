@startuml arquitetura_sistema
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 13

title Arquitetura do Sistema - TP AEDS III

package "GUI (C++ / HelloImGui)" {
    [main.cpp] as main
    [HelloImGui] as hello
    [ImguiBindings] as bindings
    [ScriptArchive] as arch
}

package "Lua Views" {
    [router.lua] as router
    [common.lua] as common
    [LoginView.lua] as login
    [MainMenu.lua] as menu
    [StudentList.lua] as stu_list
    [StudentCreate.lua] as stu_create
    [TeacherList.lua] as tch_list
    [TeacherCreate.lua] as tch_create
    [SubjectList.lua] as sub_list
    [SubjectCreate.lua] as sub_create
    [StudentDetail.lua] as stu_detail
    [StudentProfile.lua] as stu_profile
    [EnrollmentList.lua] as enr_list
    [misc.globals.lua] as globals
}

package "project_utility" {
    [Constants.hpp] as const
    [Enums.hpp] as enums
}

package "project_model" {
    [Record.hpp] as model
    [BPlusTree.hpp] as btree
    [Student.hpp] as stu_m
    [Teacher.hpp] as tch_m
    [Subject.hpp] as sub_m
    [Enrollment.hpp] as enr_m
}

package "project_controller" {
    [DataManager] as dm
    [FileManager] as fm
    [IndexCtrl] as idx
}

database "records.dat\n(Header + Chunks)" as dat
database "records.idx\n(Hash Index)" as idxfile

main --> hello
main --> bindings
main --> arch
main --> dm
hello --> router : RenderUI()
bindings --> router : imgui.* API
dm --> bindings : Lua methods

router --> login
router --> menu
router --> stu_list
router --> stu_create
router --> tch_list
router --> tch_create
router --> sub_list
router --> sub_create
router --> stu_detail
router --> stu_profile
router --> enr_list
router --> common

stu_list --> dm
stu_create --> dm
tch_list --> dm
tch_create --> dm
sub_list --> dm
sub_create --> dm
stu_detail --> dm
stu_profile --> dm
enr_list --> dm
menu --> dm
login --> dm

dm --> fm
dm --> idx
dm --> btree

fm --> model
model --> const
model --> enums
stu_m --> model
tch_m --> model
sub_m --> model
enr_m --> model
idx --> const
btree --> model

fm --> dat
idx --> idxfile
btree --> dat

@enduml
