@startuml diagrama_classes
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 13
title Diagrama de Classes - TP AEDS III

namespace project_model {

    class RecordSerializer {
        + write<T>(buf, off, val) : void
        + read<T>(buf, off) : T
        + writeStr(buf, off, str, len) : void
        + readStr(buf, off, len) : string
    }

    class UserRecord {
        + status : char
        + type : char
        + userId : int32_t
        + name : char[50]
        + email : char[30]
        + cpf : char[15]
        + isActive() : bool
        + setActive() : void
        + setDeleted() : void
        + writeCommonFields(buf) : void
        + readCommonFields(buf) : void
    }

    class StudentRecord {
        + birthDate : uint32_t
        + courseName : char[30]
        + enrollmentYear : int32_t
        + toBytes() : vector<byte>
        + fromBytes(data) : StudentRecord
    }

    class TeacherRecord {
        + department : char[30]
        + specialization : char[30]
        + hireDate : uint32_t
        + toBytes() : vector<byte>
        + fromBytes(data) : TeacherRecord
    }

    class SubjectRecord {
        + status : char
        + subjectId : int32_t
        + name : char[50]
        + code : char[20]
        + credits : int32_t
        + teacherId : int32_t
        + toBytes() : vector<byte>
        + fromBytes(data) : SubjectRecord
    }

    class BTreeLeafValue {
        + studentId : int32_t
        + subjectId : int32_t
        + teacherId : int32_t
        + grade : float
        + semester : char[12]
        + toBytes() : vector<byte>
        + fromBytes(data) : BTreeLeafValue
    }

    class BPlusTree {
        - rootPageId : int64_t
        - pageCount : size_t
        - entryCount : size_t
        + initialize(file, offset, pages) : bool
        + insert(key, value) : bool
        + search(key) : optional<BTreeLeafValue>
        + searchRange(prefix) : vector<pair>
        + erase(key) : bool
        - splitChild(parent, idx, child) : void
        - insertNonFull(node, key, value) : void
        - borrowOrMerge(parent, idx) : void
    }

    class FileHeader {
        + magic : uint32_t
        + version : uint32_t
        + headerSize : uint32_t
        + chunkCount : uint32_t
        + nextStudentId, nextTeacherId, nextSubjectId : uint32_t
        + toBytes() : vector<byte>
        + fromBytes(data) : FileHeader
    }

    class ChunkInfo {
        + type : char
        + offset : uint64_t
        + recordSize : uint32_t
        + capacity : uint32_t
        + used : uint32_t
        + toBytes() : vector<byte>
        + fromBytes(data) : ChunkInfo
    }

    StudentRecord -up-|> UserRecord
    TeacherRecord -up-|> UserRecord
    BPlusTree --> BTreeLeafValue
}

namespace project_controller {

    class FileManager {
        - recordSize_ : size_t
        + initialize(path) : bool
        + readRecord(index) : optional<byte[]>
        + appendRecord(data) : bool
        + markDeleted(index) : bool
        + setRecordSize(size) : void
    }

    class IndexValue {
        + chunkIndex : uint32_t
        + recordIndex : uint32_t
    }

    class IndexCtrl {
        - map_ : unordered_map<string, IndexEntry>
        + initialize(path) : bool
        + insert(key, chunkIdx, recIdx) : bool
        + lookup(key) : optional<IndexValue>
        + remove(key) : bool
        + nextId(prefix) : uint32_t
        + save() : bool
        + load() : bool
    }

    class DataManager {
        - dataFile_ : fstream
        - chunks_[4] : ChunkInfo
        - btree_ : BPlusTree
        - indexCtrl_ : IndexCtrl
        + initialize(dataDir) : bool
        + createStudent(...) : bool
        + createTeacher(...) : bool
        + createSubject(...) : bool
        + readStudent(id) : optional<StudentRecord>
        + readTeacher(id) : optional<TeacherRecord>
        + readSubject(id) : optional<SubjectRecord>
        + listAllStudents() : vector<StudentRecord>
        + listAllTeachers() : vector<TeacherRecord>
        + listAllSubjects() : vector<SubjectRecord>
        + enrollStudent(sid, bid, tid, sem) : bool
        + getEnrollmentsByStudent(sid) : vector<BTreeLeafValue>
        + getEnrollmentsBySubject(bid) : vector<BTreeLeafValue>
        + unenroll(sid, bid) : bool
        + updateGrade(sid, bid, grade) : bool
        - reallocateChunk(ci) : bool
        - computeChunkOffsets() : void
    }

    DataManager --> BPlusTree
    DataManager --> IndexCtrl
    DataManager --> FileManager
    DataManager --> ChunkInfo
    DataManager --> FileHeader
}

@enduml
