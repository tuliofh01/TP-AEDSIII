@startuml diagrama_sequencia_crud
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12

title Diagrama de Sequencia - Operacoes CRUD

actor Usuario as U
participant "router.lua" as R
participant "StudentCreate.lua" as SC
participant "TeacherCreate.lua" as TC
participant "SubjectCreate.lua" as SBC
participant "EnrollmentList.lua" as EL
participant "DataManager" as DM
participant "FileManager" as FM
participant "IndexCtrl" as IX
participant "BPlusTree" as BT
database "records.dat" as DAT
database "records.idx" as IDX

== Cadastro de Aluno ==

U -> SC : preenche formulario
SC -> DM : createStudent(name, email, cpf, birthDate, course, year)
DM -> IX : nextId("STU:")
IX --> DM : 1
DM -> DM : StudentRecord::toBytes()
DM -> DAT : appendToChunk('S', bytes)
DAT --> DM : index da gravacao
DM -> IX : insert("STU:1", chunk, index)
DM -> IX : insert("NM:nome", chunk, index)
DM -> IX : save()
DM --> SC : true
SC -> U : sucesso

== Cadastro de Professor ==

U -> TC : preenche formulario
TC -> DM : createTeacher(name, email, cpf, dept, spec, hireDate)
DM -> IX : nextId("TCH:")
DM -> DAT : appendToChunk('T', bytes)
DM -> IX : insert("TCH:1", chunk, index)
DM -> IX : save()
DM --> TC : true

== Cadastro de Disciplina ==

U -> SBC : preenche formulario
SBC -> DM : createSubject(name, code, credits, teacherId)
DM -> IX : nextId("SUB:")
DM -> DAT : appendToChunk('B', bytes)
DM -> IX : insert("SUB:1", chunk, index)
DM --> SBC : true

== Matricula (B+ Tree) ==

U -> EL : studentId, subjectId, teacherId, semester
EL -> DM : enrollStudent(1, 1, 1, "2026-1")
DM -> BT : search("ENR:STU:0001:SUB:0001")
BT --> DM : null (nao existe)
DM -> BT : insert("ENR:STU:0001:SUB:0001", value)
BT -> DAT : salva pagina alterada
BT --> DM : true
DM --> EL : true
EL -> U : sucesso

== Consultar Matriculas por Aluno ==

U -> EL : ID do aluno
EL -> DM : getEnrollmentsByStudent(1)
DM -> BT : searchRange("ENR:STU:0001:")
BT -> DAT : percorre folhas
BT --> DM : [entry1, entry2, ...]
DM --> EL : vetor de matriculas
EL -> U : exibe lista

== Atualizar Nota ==

U -> EL : studentId, subjectId, grade
EL -> DM : updateGrade(1, 1, 8.5)
DM -> BT : search(key)
BT --> DM : oldValue
DM -> BT : erase(key)
DM -> BT : insert(key, updatedValue)
DM --> EL : true
EL -> U : nota atualizada

== Leitura por ID (qualquer entidade) ==

U -> SC : consulta por ID
SC -> DM : readStudent(1)
DM -> IX : lookup("STU:1")
IX --> DM : (chunk=0, index=42)
DM -> DAT : readFromChunk(0, 42)
DAT --> DM : bytes
DM -> DM : StudentRecord::fromBytes()
DM --> SC : StudentRecord

== Reallocacao de Chunk ==

DM -> DM : used >= capacity
DM -> DM : reallocateChunk(ci)
DM -> DAT : cria novo layout
note right: dobra capacity,\nreescreve arquivo
DM -> BT : atualiza chunkOffset
DM -> IX : indices permanecem validos
@enduml
